# Ejemplo de configuración
# Copia este archivo como .env y coloca tus valores reales (el .env real no se sube a GitHub)

DB_NAME=plataformapark_db
DB_USER=postgres_usuario_seguro
DB_PASSWORD=postgres_password_seguro
DJANGO_SECRET_KEY=clave_secreta_django
UNIFI_USER=admin
UNIFI_PASSWORD=tu_password_de_unifi
# Opcional pero recomendado para UniFi 10: API Key (en UniFi: Settings > Control Plane > Integrations)
# UNIFI_API_KEY=tu_api_key_aqui
UNIFI_DURATION_MINUTES=1440
DEBUG=False
